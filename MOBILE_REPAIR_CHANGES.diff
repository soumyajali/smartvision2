+import '../../services/voice_input_service.dart';
+import '../../widgets/sv_app_bar.dart';
+import '../../widgets/sv_ui.dart';
+
+class _Turn {
+  const _Turn({required this.question, required this.answer, this.source});
+
+  final String question;
+  final String answer;
+  final String? source;
+}
+
+/// Voice Assistant: spoken (or typed) questions and commands → answers that
+/// are spoken back with text-to-speech. Mirrors the website's assistant.
+class VoiceAssistantScreen extends StatefulWidget {
+  const VoiceAssistantScreen({super.key});
+
+  @override
+  State<VoiceAssistantScreen> createState() => _VoiceAssistantScreenState();
+}
+
+class _VoiceAssistantScreenState extends State<VoiceAssistantScreen> {
+  final TextEditingController _input = TextEditingController();
+  final List<_Turn> _turns = [];
+  bool? _speechAvailable;
+  bool _listening = false;
+  bool _thinking = false;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    VoiceInputService.isAvailable().then((value) {
+      if (mounted) setState(() => _speechAvailable = value);
+    });
+  }
+
+  @override
+  void dispose() {
+    _input.dispose();
+    super.dispose();
+  }
+
+  Future<void> _listen() async {
+    if (_listening || _thinking) return;
+    setState(() {
+      _listening = true;
+      _error = null;
+    });
+    try {
+      final text = await VoiceInputService.listen(
+        prompt: 'Ask SmartVision a question or say a command',
+      );
+      if (!mounted) return;
+      setState(() => _listening = false);
+      if (text == null) {
+        setState(() => _error = 'Nothing was recognised. Tap the microphone '
+            'and speak clearly, or type your question.');
+        return;
+      }
+      await _handle(text);
+    } on VoiceInputException catch (error) {
+      if (!mounted) return;
+      setState(() {
+        _listening = false;
+        _error = error.message;
+      });
+    }
+  }
+
+  Future<void> _handle(String message) async {
+    final text = message.trim();
+    if (text.isEmpty) return;
+    final speech = context.read<SpeechService>();
+    final detection = context.read<DetectionController>();
+    final backend = context.read<BackendService>();
+    setState(() {
+      _thinking = true;
+      _error = null;
+    });
+
+    var answer = '';
+    String source = 'on-device';
+    String? navigateTo;
+    final command = AssistantBrain.parse(text);
+    switch (command.action) {
+      case AssistantAction.navigate:
+        final destination = AppDestinations.forRoute(command.value);
+        answer = 'Opening ${destination?.label ?? 'page'}.';
+        navigateTo = command.value;
+        break;
+      case AssistantAction.announcements:
+        final on = command.value == 'on';
+        speech.toggleVoice(on);
+        answer = 'Voice announcements turned ${command.value}.';
+        break;
+      case AssistantAction.tracking:
+        answer = 'Object tracking across frames is only available on the '
+            'website. The mobile app reports detections per frame.';
+        break;
+      case AssistantAction.resetAnnouncements:
+        await speech.stop();
+        answer = 'Voice announcements reset.';
+        break;
+      case AssistantAction.unknown:
+        answer = "I couldn't find that page. Try \"open object detection\" or "
+            '"go to history".';
+        break;
+      case AssistantAction.question:
+        final normalized = text.toLowerCase();
+        final feature = AssistantBrain.answerApplicationQuestion(text);
+        if (feature != null) {
+          answer = feature;
+        } else if (AssistantBrain.isSceneQuestion(normalized)) {
+          answer = AssistantBrain.describeDetections(
+            detection.currentResults,
+            hasResult: detection.lastOutcome != null,
+          );
+        } else if (backend.isOnline) {
+          try {
+            answer = await backend.chatbotQuery(
+              query: text,
+              detections: [
+                for (final r in detection.currentResults)
+                  {'label': r.label, 'confidence': r.confidence},
+              ],
+              counts: Map<String, int>.from(detection.objectCounts),
+            );
+            source = 'SmartVision server';
+          } catch (error) {
+            answer = 'The SmartVision server could not answer ($error).';
+          }
+        } else {
+          answer = "I can answer questions about SmartVision's features and "
+              'the latest detection results. For open-ended questions, '
+              'connect the SmartVision server in Settings.';
+        }
+        break;
+    }
+
+    if (!mounted) return;
+    setState(() {
+      _thinking = false;
+      _turns.insert(
+          0, _Turn(question: text, answer: answer, source: source));
+    });
+    _input.clear();
+    await speech.speakAnswer(answer);
+    if (navigateTo != null && mounted) {
+      context.go(navigateTo);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final speech = context.watch<SpeechService>();
+    final available = _speechAvailable;
+    return Scaffold(
+      backgroundColor: AppColors.primaryBackground,
+      appBar: const SvAppBar(title: 'Voice Assistant'),
+      body: ListView(
+        padding: const EdgeInsets.fromLTRB(16, 16, 16, 24),
+        children: [
+          SvCard(
+            highlight: true,
+            child: Column(
+              children: [
+                const Text(
+                  'SmartVision Voice Assistant',
+                  style: TextStyle(
+                    color: AppColors.accentCyan,
+                    fontSize: 12,
+                    fontWeight: FontWeight.w800,
+                    letterSpacing: 1.2,
+                  ),
+                ),
+                const SizedBox(height: 6),
+                const Text(
+                  'Ask a question or give a command',
+                  textAlign: TextAlign.center,
+                  style: TextStyle(
+                    color: AppColors.primaryText,
+                    fontSize: 18,
+                    fontWeight: FontWeight.w700,
+                  ),
+                ),
+                const SizedBox(height: 18),
+                Semantics(
+                  button: true,
+                  label: 'Speak a question',
+                  child: GestureDetector(
+                    onTap: available == false ? null : _listen,
+                    child: AnimatedContainer(
+                      duration: const Duration(milliseconds: 250),
+                      width: 96,
+                      height: 96,
+                      decoration: BoxDecoration(
+                        shape: BoxShape.circle,
+                        gradient: available == false
+                            ? null
+                            : AppColors.primaryGradient,
+                        color: available == false
+                            ? AppColors.elevatedSurface
+                            : null,
+                        boxShadow: [
+                          BoxShadow(
+                            color: AppColors.accentCyan.withValues(
+                                alpha: _listening ? 0.55 : 0.25),
+                            blurRadius: _listening ? 30 : 16,
+                            spreadRadius: _listening ? 4 : 0,
+                          ),
+                        ],
+                      ),
+                      child: Icon(
+                        _listening ? Icons.graphic_eq_rounded : Icons.mic_rounded,
+                        color: Colors.white,
+                        size: 42,
+                      ),
+                    ),
+                  ),
+                ),
+                const SizedBox(height: 12),
+                Text(
+                  available == null
+                      ? 'Checking speech recognition…'
+                      : available
+                          ? (_listening
+                              ? 'Listening…'
+                              : _thinking
+                                  ? 'Thinking…'
+                                  : 'Tap the microphone to speak')
+                          : 'Speech recognition is not available on this '
+                              'device. Type your question below.',
+                  textAlign: TextAlign.center,
+                  style: const TextStyle(color: AppColors.secondaryText),
+                ),
+                const SizedBox(height: 14),
+                Row(
+                  children: [
+                    Expanded(
+                      child: TextField(
+                        controller: _input,
+                        enabled: !_thinking,
+                        style: const TextStyle(color: AppColors.primaryText),
+                        textInputAction: TextInputAction.send,
+                        onSubmitted: _handle,
+                        decoration: const InputDecoration(
+                          hintText: 'Or type, e.g. "what do you see?"',
+                          isDense: true,
+                        ),
+                      ),
+                    ),
+                    const SizedBox(width: 8),
+                    IconButton.filled(
+                      tooltip: 'Send',
+                      onPressed:
+                          _thinking ? null : () => _handle(_input.text),
+                      icon: const Icon(Icons.send_rounded),
+                    ),
+                  ],
+                ),
+                const SizedBox(height: 6),
+                SwitchListTile(
+                  contentPadding: EdgeInsets.zero,
+                  value: speech.settings.enabled,
+                  onChanged: speech.toggleVoice,
+                  title: const Text(
+                    'Automatic detection announcements',
+                    style: TextStyle(color: AppColors.primaryText, fontSize: 13),
+                  ),
+                  subtitle: const Text(
+                    'Answers here are always spoken aloud.',
+                    style: TextStyle(color: AppColors.mutedText, fontSize: 11.5),
+                  ),
+                ),
+              ],
+            ),
+          ),
+          if (_error != null) ...[
+            const SizedBox(height: 12),
+            SvNotice(tone: SvTone.warning, message: _error!),
+          ],
+          const SizedBox(height: 14),
+          SvCard(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.stretch,
+              children: [
+                const SvSectionTitle('Try saying', icon: Icons.lightbulb_outline),
+                const SizedBox(height: 8),
+                Wrap(
+                  spacing: 6,
+                  runSpacing: 6,
+                  children: [
+                    for (final example in const [
+                      'What do you see?',
+                      'What features does this app have?',
+                      'Tell me about OCR',
+                      'Open object detection',
+                      'Go to history',
+                      'Turn off voice announcements',
+                    ])
+                      ActionChip(
+                        label: Text(example),
+                        labelStyle: const TextStyle(
+                            color: AppColors.secondaryText, fontSize: 12),
+                        backgroundColor: AppColors.elevatedSurface,
+                        side: const BorderSide(color: AppColors.border),
+                        onPressed: _thinking ? null : () => _handle(example),
+                      ),
+                  ],
+                ),
+              ],
+            ),
+          ),
+          const SizedBox(height: 14),
+          if (_turns.isEmpty)
+            const SvCard(
+              child: SvEmptyState(
+                icon: Icons.record_voice_over_outlined,
+                title: 'No questions yet',
+                message: 'Your questions and the assistant\'s answers appear '
+                    'here.',
+              ),
+            )
+          else
+            for (final turn in _turns)
+              SvCard(
+                margin: const EdgeInsets.only(bottom: 10),
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Text(
+                      '“${turn.question}”',
+                      style: const TextStyle(
+                        color: AppColors.accentCyan,
+                        fontWeight: FontWeight.w600,
+                      ),
+                    ),
+                    const SizedBox(height: 6),
+                    Text(
+                      turn.answer,
+                      style: const TextStyle(
+                        color: AppColors.primaryText,
+                        height: 1.4,
+                      ),
+                    ),
+                    const SizedBox(height: 6),
+                    Row(
+                      children: [
+                        Expanded(
+                          child: Text(
+                            'Answered by: ${turn.source ?? 'on-device'}',
+                            style: const TextStyle(
+                                color: AppColors.mutedText, fontSize: 11),
+                          ),
+                        ),
+                        IconButton(
+                          tooltip: 'Speak again',
+                          onPressed: () => speech.speakAnswer(turn.answer),
+                          icon: const Icon(Icons.volume_up_outlined,
+                              size: 18, color: AppColors.mutedText),
+                        ),
+                      ],
+                    ),
+                  ],
+                ),
+              ),
+        ],
+      ),
+    );
+  }
+}
diff --git a/lib/services/alert_sound_service.dart b/lib/services/alert_sound_service.dart
new file mode 100644
index 0000000..15d1623
--- /dev/null
+++ b/lib/services/alert_sound_service.dart
@@ -0,0 +1,65 @@
+import 'dart:developer';
+
+import 'package:video_player/video_player.dart';
+
+/// Plays the project's siren (assets/sounds/siren.wav, the same file the
+/// website uses) for hazard and drowsiness alerts. video_player is already a
+/// dependency and can play audio-only assets.
+class AlertSoundService {
+  AlertSoundService._();
+
+  static final AlertSoundService instance = AlertSoundService._();
+  static const String sirenAsset = 'assets/sounds/siren.wav';
+
+  VideoPlayerController? _controller;
+  Future<void>? _loading;
+  DateTime? _lastPlayed;
+  String? lastError;
+
+  bool enabled = true;
+
+  Future<void> _ensureLoaded() {
+    if (_controller != null) return Future<void>.value();
+    return _loading ??= () async {
+      final controller = VideoPlayerController.asset(sirenAsset);
+      try {
+        await controller.initialize();
+        _controller = controller;
+      } catch (error) {
+        lastError = 'Siren sound unavailable: $error';
+        log(lastError!);
+        await controller.dispose();
+      }
+    }()
+        .whenComplete(() => _loading = null);
+  }
+
+  /// Plays the siren unless it played less than [cooldown] ago.
+  Future<void> playSiren({
+    Duration cooldown = const Duration(milliseconds: 2500),
+    bool force = false,
+  }) async {
+    if (!enabled && !force) return;
+    final now = DateTime.now();
+    final last = _lastPlayed;
+    if (!force && last != null && now.difference(last) < cooldown) return;
+    _lastPlayed = now;
+    await _ensureLoaded();
+    final controller = _controller;
+    if (controller == null) return;
+    try {
+      await controller.seekTo(Duration.zero);
+      await controller.setVolume(1.0);
+      await controller.play();
+    } catch (error) {
+      lastError = 'Could not play siren: $error';
+      log(lastError!);
+    }
+  }
+
+  Future<void> stop() async {
+    try {
+      await _controller?.pause();
+    } catch (_) {}
+  }
+}
diff --git a/lib/services/assistant_brain.dart b/lib/services/assistant_brain.dart
new file mode 100644
index 0000000..6ac3d0b
--- /dev/null
+++ b/lib/services/assistant_brain.dart
@@ -0,0 +1,262 @@
+import '../core/navigation/app_destinations.dart';
+import '../models/detection_result.dart';
+
+/// Mobile port of the website's assistant logic (voice_interaction.py):
+/// command parsing, feature questions and latest-result questions.
+/// Anything it cannot answer from real app data returns null so the caller
+/// can ask the server's chatbot (or say it does not know).
+
+enum AssistantAction { navigate, announcements, tracking, resetAnnouncements, question, unknown }
+
+class AssistantCommand {
+  const AssistantCommand(this.action, [this.value = '']);
+
+  final AssistantAction action;
+  final String value;
+}
+
+class AssistantBrain {
+  const AssistantBrain._();
+
+  static String _normalize(String text) => text
+      .toLowerCase()
+      .replaceAll(RegExp(r'[^a-z0-9 ]'), ' ')
+      .split(RegExp(r'\s+'))
+      .where((part) => part.isNotEmpty)
+      .join(' ');
+
+  /// Same commands and phrasing as parse_voice_command() on the website.
+  static AssistantCommand parse(String transcript) {
+    final normalized = _normalize(transcript);
+    const commands = <String, AssistantCommand>{
+      'enable voice announcements':
+          AssistantCommand(AssistantAction.announcements, 'on'),
+      'turn on voice announcements':
+          AssistantCommand(AssistantAction.announcements, 'on'),
+      'disable voice announcements':
+          AssistantCommand(AssistantAction.announcements, 'off'),
+      'turn off voice announcements':
+          AssistantCommand(AssistantAction.announcements, 'off'),
+      'enable object tracking': AssistantCommand(AssistantAction.tracking, 'on'),
+      'start object tracking': AssistantCommand(AssistantAction.tracking, 'on'),
+      'disable object tracking':
+          AssistantCommand(AssistantAction.tracking, 'off'),
+      'stop object tracking': AssistantCommand(AssistantAction.tracking, 'off'),
+      'reset voice announcements':
+          AssistantCommand(AssistantAction.resetAnnouncements),
+      'clear voice announcements':
+          AssistantCommand(AssistantAction.resetAnnouncements),
+    };
+    final command = commands[normalized];
+    if (command != null) return command;
+
+    String? target;
+    for (final prefix in const ['open ', 'go to ', 'navigate to ', 'take me to ']) {
+      if (normalized.startsWith(prefix)) {
+        target = normalized.substring(prefix.length);
+        break;
+      }
+    }
+    if (target == null) {
+      return AssistantCommand(AssistantAction.question, transcript.trim());
+    }
+    final destination = _matchDestination(target);
+    if (destination != null) {
+      return AssistantCommand(AssistantAction.navigate, destination.route);
+    }
+    return const AssistantCommand(AssistantAction.unknown);
+  }
+
+  static AppDestination? _matchDestination(String target) {
+    const aliases = <String, String>{
+      'home': '/home',
+      'dashboard': '/home',
+      'video review': '/video_review',
+      'fast video review': '/video_review',
+      'video fast review': '/video_review',
+      'ocr': '/document_screening',
+      'text recognition': '/document_screening',
+      'face recognition': '/face_id',
+      'face registration': '/face_id',
+      'object detection': '/camera_detection',
+      'detection': '/camera_detection',
+      'camera': '/camera_detection',
+      'drowsiness monitor': '/drowsiness',
+      'drowsiness': '/drowsiness',
+      'research evaluation': '/research_evaluation',
+      'automl': '/automl',
+      'auto ml': '/automl',
+      'automl dataset pipeline': '/automl',
+      'automl and dataset pipeline': '/automl',
+      'dataset pipeline': '/automl',
+      'history': '/history',
+      'settings': '/settings',
+      'vision chatbot': '/chatbot',
+      'chatbot': '/chatbot',
+      'voice assistant': '/voice_assistant',
+      'analytics': '/statistics',
+      'hazard alerts': '/alerts',
+      'find my item': '/find_object',
+      'about': '/about',
+    };
+    final route = aliases[target];
+    if (route != null) return AppDestinations.forRoute(route);
+    for (final destination in AppDestinations.all) {
+      if (_normalize(destination.label) == target) return destination;
+    }
+    return null;
+  }
+
+  static const List<(List<String>, String)> _features = [
+    (
+      ['dashboard', 'home page', 'live detection', 'real time detection'],
+      'The Dashboard shows live detection status, the camera preview with '
+          'bounding boxes, a detection summary, detection settings and recent '
+          'activity. You can start camera detection or upload and capture images.',
+    ),
+    (
+      ['object detection', 'detect objects', 'object recognition', 'yolo'],
+      'Object Detection runs the bundled YOLOv8n model on the phone for live '
+          'camera frames, photos and videos, and shows labels, confidence scores '
+          'and boxes.',
+    ),
+    (
+      ['vision chatbot', 'chatbot', 'typed questions'],
+      'Vision Chatbot answers typed questions about the latest detections. '
+          'When the SmartVision server is connected it uses the same assistant '
+          'as the website.',
+    ),
+    (
+      ['voice assistant', 'voice control', 'voice commands', 'voice question'],
+      'Voice Assistant accepts spoken questions and commands. It can explain '
+          'features, describe the latest results, open pages and switch voice '
+          'announcements on or off. Speech recognition uses the phone\'s '
+          'speech service, which may send audio to Google.',
+    ),
+    (
+      ['ocr', 'read text', 'text recognition', 'translate', 'translation'],
+      'OCR extracts text from photos and videos on the phone, and can '
+          'translate or summarize the extracted text with separate buttons.',
+    ),
+    (
+      ['face registration', 'face recognition', 'register face', 'facial recognition'],
+      'Face Recognition detects faces on the phone. Recognizing or registering '
+          'people uses the SmartVision server\'s face models.',
+    ),
+    (
+      ['history', 'detection history', 'saved detections'],
+      'History shows detections and analyses saved on this phone.',
+    ),
+    (
+      ['video fast review', 'search video', 'find in video', 'video search'],
+      'Fast Video Review scans a video for a selected object category and '
+          'reports the timestamps where it appears.',
+    ),
+    (
+      ['drowsiness', 'fatigue', 'driver monitoring'],
+      'Drowsiness Monitor watches your eyes with the front camera and raises '
+          'an alert when they stay closed too long. It can also analyse a video.',
+    ),
+    (
+      ['research evaluation', 'benchmark'],
+      'Research Evaluation runs a real benchmark of the on-device model and '
+          'shows the comparison figures reported on the website.',
+    ),
+    (
+      ['automl', 'dataset', 'dataset pipeline'],
+      'AutoML and Dataset Pipeline shows the server\'s dataset splits, sources, '
+          'classes and storage.',
+    ),
+    (
+      ['settings', 'preferences', 'confidence threshold'],
+      'Settings control voice announcements, detection thresholds, the siren, '
+          'translation language and the optional server connection.',
+    ),
+  ];
+
+  /// Answers feature questions; null when the question is about results or
+  /// unknown.
+  static String? answerApplicationQuestion(String question) {
+    final normalized = _normalize(question);
+    if (normalized.isEmpty) return null;
+    if (isSceneQuestion(normalized) || isOcrQuestion(normalized)) return null;
+    for (final (terms, description) in _features) {
+      if (terms.any(normalized.contains)) return description;
+    }
+    const appPhrases = [
+      'this application',
+      'this app',
+      'the app',
+      'what can you do',
+      'what features',
+      'available features',
+      'app features',
+      'what are the features',
+      'list the features',
+    ];
+    if (appPhrases.any(normalized.contains)) {
+      return 'SmartVision can detect objects live or in photos and videos, read '
+          'and translate text, detect faces, review videos for an object, '
+          'monitor drowsiness, and keep a history of results. It also has a '
+          'chatbot and this voice assistant. Ask me about any feature.';
+    }
+    return null;
+  }
+
+  static bool isSceneQuestion(String normalized) => const [
+        'what do you see',
+        'what can you see',
+        'what is in',
+        'describe the scene',
+        'what did it detect',
+        'what has been detected',
+        'detection result',
+        'explain the results',
+        'explain the output',
+        'how many',
+        'what objects',
+        'any hazard',
+        'is there',
+        'are there',
+      ].any(normalized.contains);
+
+  static bool isOcrQuestion(String normalized) => const [
+        'what did ocr read',
+        'ocr result',
+        'extracted text',
+        'recognized text',
+        'read the text',
+      ].any(normalized.contains);
+
+  /// Describes the latest real detection result (same wording style as
+  /// answer_scene_question on the website).
+  static String describeDetections(
+    List<DetectionResult> results, {
+    required bool hasResult,
+  }) {
+    if (!hasResult) {
+      return "I don't have a recent detection result yet. Open Object "
+          'Detection, analyse an image or start live detection, then ask me '
+          'again.';
+    }
+    if (results.isEmpty) {
+      return 'The latest object-detection output contains no objects above '
+          'the confidence threshold.';
+    }
+    final grouped = <String, List<double>>{};
+    for (final r in results) {
+      grouped.putIfAbsent(r.label, () => []).add(r.confidence);
+    }
+    final parts = grouped.entries.map((entry) {
+      final count = entry.value.length;
+      final avg = entry.value.reduce((a, b) => a + b) / count;
+      return '$count ${entry.key}${count == 1 ? '' : 's'} '
+          '(average confidence ${(avg * 100).toStringAsFixed(0)}%)';
+    }).join(', ');
+    final hazards =
+        results.where((r) => r.isHazard).map((r) => r.label).toSet();
+    return 'The latest object-detection output recognized $parts.'
+        '${hazards.isEmpty ? '' : ' Hazards: ${hazards.join(', ')}.'}'
+        ' This is based on detected labels, not full scene understanding.';
+  }
+}
diff --git a/lib/services/backend_service.dart b/lib/services/backend_service.dart
new file mode 100644
index 0000000..ee20983
--- /dev/null
+++ b/lib/services/backend_service.dart
@@ -0,0 +1,309 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+
+import '../core/config/api_config.dart';
+import 'database_service.dart';
+
+enum BackendStatus { notConfigured, checking, online, offline }
+
+class BackendException implements Exception {
+  BackendException(this.message, {this.statusCode});
+
+  final String message;
+  final int? statusCode;
+
+  @override
+  String toString() => message;
+}
+
+/// Thin client for the SmartVision FastAPI backend (ai_server.py) with a real
+/// health check. Nothing here fabricates data: when the server is not
+/// reachable every call throws a [BackendException].
+class BackendService extends ChangeNotifier {
+  BackendService(this._database) {
+    _load();
+  }
+
+  static const String _urlKey = 'backend_url';
+
+  final DatabaseService _database;
+  String? _baseUrl;
+  bool _loaded = false;
+  BackendStatus _status = BackendStatus.notConfigured;
+  String? _lastError;
+  int? _lastLatencyMs;
+  DateTime? _lastCheckedAt;
+  Map<String, dynamic>? _serverInfo;
+  Timer? _pollTimer;
+  bool _checking = false;
+  bool _disposed = false;
+
+  @override
+  void notifyListeners() {
+    if (!_disposed) super.notifyListeners();
+  }
+
+  String? get baseUrl => _baseUrl;
+  bool get isConfigured => _baseUrl != null;
+  bool get isOnline => _status == BackendStatus.online;
+  BackendStatus get status => _status;
+  String? get lastError => _lastError;
+  int? get lastLatencyMs => _lastLatencyMs;
+  DateTime? get lastCheckedAt => _lastCheckedAt;
+  Map<String, dynamic>? get serverInfo => _serverInfo;
+  bool get isLoaded => _loaded;
+
+  String get statusLabel {
+    switch (_status) {
+      case BackendStatus.notConfigured:
+        return 'Server not set';
+      case BackendStatus.checking:
+        return 'Checking…';
+      case BackendStatus.online:
+        return 'Server online';
+      case BackendStatus.offline:
+        return 'Server offline';
+    }
+  }
+
+  Future<void> _load() async {
+    try {
+      final saved = await _database.getAppSetting(_urlKey);
+      _baseUrl = ApiConfig.normalize(saved) ?? ApiConfig.defaultUrl;
+    } catch (_) {
+      _baseUrl = ApiConfig.defaultUrl;
+    }
+    _loaded = true;
+    _status =
+        _baseUrl == null ? BackendStatus.notConfigured : BackendStatus.checking;
+    notifyListeners();
+    _startPolling();
+    await checkHealth();
+  }
+
+  void _startPolling() {
+    _pollTimer?.cancel();
+    if (_baseUrl == null || _disposed) return;
+    _pollTimer = Timer.periodic(ApiConfig.healthPollInterval, (_) {
+      checkHealth();
+    });
+  }
+
+  /// Saves a new server URL (or clears it with null/empty) and re-checks.
+  Future<void> setBaseUrl(String? input) async {
+    final normalized = ApiConfig.normalize(input);
+    _baseUrl = normalized;
+    _serverInfo = null;
+    _lastError = null;
+    _status = normalized == null
+        ? BackendStatus.notConfigured
+        : BackendStatus.checking;
+    notifyListeners();
+    await _database.setAppSetting(_urlKey, normalized ?? '');
+    _startPolling();
+    if (normalized != null) await checkHealth();
+  }
+
+  /// Calls GET /health and updates [status] with the real result.
+  Future<bool> checkHealth() async {
+    final base = _baseUrl;
+    if (base == null) {
+      _status = BackendStatus.notConfigured;
+      notifyListeners();
+      return false;
+    }
+    if (_checking) return isOnline;
+    _checking = true;
+    if (_status != BackendStatus.online) {
+      _status = BackendStatus.checking;
+      notifyListeners();
+    }
+    final stopwatch = Stopwatch()..start();
+    try {
+      final body = await _send('GET', '/health', timeout: ApiConfig.healthTimeout);
+      _lastLatencyMs = stopwatch.elapsedMilliseconds;
+      final healthy = body['status'] == 'healthy' || body['status'] == 'ok';
+      _status = healthy ? BackendStatus.online : BackendStatus.offline;
+      _lastError = healthy ? null : 'Unexpected /health response: $body';
+      if (healthy && _serverInfo == null) {
+        // Optional details (older servers do not have this endpoint).
+        try {
+          _serverInfo = await _send('GET', '/system/info',
+              timeout: ApiConfig.healthTimeout);
+        } catch (_) {
+          _serverInfo = null;
+        }
+      }
+    } catch (error) {
+      _status = BackendStatus.offline;
+      _lastLatencyMs = null;
+      _lastError = _describe(error, base);
+    } finally {
+      _checking = false;
+      _lastCheckedAt = DateTime.now();
+      notifyListeners();
+    }
+    return isOnline;
+  }
+
+  String _describe(Object error, String base) {
+    if (error is BackendException) return error.message;
+    if (error is TimeoutException) {
+      return 'No response from $base within '
+          '${ApiConfig.healthTimeout.inSeconds}s.';
+    }
+    if (error is SocketException) {
+      final hint = ApiConfig.isLoopback(base)
+          ? ' On a phone, "localhost" is the phone itself — use your '
+              "computer's LAN IP (e.g. http://192.168.1.20:8000)."
+          : ' Check that the phone and the server are on the same network, '
+              'the server runs with --host 0.0.0.0, and port 8000 is allowed '
+              'through the firewall.';
+      return 'Cannot reach $base (${error.osError?.message ?? error.message}).$hint';
+    }
+    if (error is HandshakeException) {
+      return 'TLS handshake with $base failed: ${error.message}';
+    }
+    return error.toString();
+  }
+
+  Future<Map<String, dynamic>> _send(
+    String method,
+    String path, {
+    Map<String, dynamic>? body,
+    Duration timeout = ApiConfig.requestTimeout,
+  }) async {
+    final base = _baseUrl;
+    if (base == null) {
+      throw BackendException(
+          'No backend server is configured. Set one in Settings.');
+    }
+    final client = HttpClient()..connectionTimeout = timeout;
+    try {
+      final request = await client
+          .openUrl(method, Uri.parse('$base$path'))
+          .timeout(timeout);
+      request.headers.set(HttpHeaders.acceptHeader, 'application/json');
+      if (body != null) {
+        final encoded = utf8.encode(jsonEncode(body));
+        request.headers.contentType = ContentType.json;
+        request.contentLength = encoded.length;
+        request.add(encoded);
+      }
+      final response = await request.close().timeout(timeout);
+      final text = await response.transform(utf8.decoder).join().timeout(timeout);
+      dynamic decoded;
+      try {
+        decoded = text.isEmpty ? <String, dynamic>{} : jsonDecode(text);
+      } catch (_) {
+        decoded = null;
+      }
+      if (response.statusCode < 200 || response.statusCode >= 300) {
+        final detail = decoded is Map && decoded['detail'] != null
+            ? decoded['detail'].toString()
+            : text;
+        throw BackendException(
+          'Server error ${response.statusCode}: $detail',
+          statusCode: response.statusCode,
+        );
+      }
+      if (decoded is! Map) {
+        throw BackendException('Server returned an unexpected response.');
+      }
+      return Map<String, dynamic>.from(decoded);
+    } finally {
+      client.close(force: true);
+    }
+  }
+
+  Future<Map<String, dynamic>> _post(
+    String path,
+    Map<String, dynamic> body, {
+    Duration timeout = ApiConfig.requestTimeout,
+  }) async {
+    try {
+      return await _send('POST', path, body: body, timeout: timeout);
+    } catch (error) {
+      if (error is BackendException) rethrow;
+      final base = _baseUrl ?? '';
+      // A failed request is a real connectivity signal: update the status.
+      if (error is SocketException || error is TimeoutException) {
+        _status = BackendStatus.offline;
+        _lastError = _describe(error, base);
+        notifyListeners();
+      }
+      throw BackendException(_describe(error, base));
+    }
+  }
+
+  // ------------------------------------------------------------ endpoints ---
+
+  /// POST /chatbot/query — same endpoint/contract the website's assistant
+  /// logic exposes for mobile clients.
+  Future<String> chatbotQuery({
+    required String query,
+    required List<Map<String, dynamic>> detections,
+    required Map<String, int> counts,
+    String ocrText = '',
+  }) async {
+    final response = await _post('/chatbot/query', {
+      'query': query,
+      'context': {'detections': detections, 'counts': counts},
+      'ocr_text': ocrText,
+      'provider': 'auto',
+    });
+    final reply = response['response']?.toString() ?? '';
+    if (reply.trim().isEmpty) {
+      throw BackendException('The chatbot returned an empty answer.');
+    }
+    return reply;
+  }
+
+  /// POST /face/register (JSON body {image, name}).
+  Future<String> registerFace({
+    required String name,
+    required Uint8List imageBytes,
+  }) async {
+    final response = await _post(
+      '/face/register',
+      {'image': base64Encode(imageBytes), 'name': name},
+      timeout: ApiConfig.uploadTimeout,
+    );
+    return response['message']?.toString() ?? 'Registered $name';
+  }
+
+  /// POST /face/recognize → list of {name, confidence, box:[x, y, w, h]}.
+  Future<List<Map<String, dynamic>>> recognizeFace(Uint8List imageBytes) async {
+    final response = await _post(
+      '/face/recognize',
+      {'image': base64Encode(imageBytes)},
+      timeout: ApiConfig.uploadTimeout,
+    );
+    final list = response['recognitions'];
+    if (list is! List) return const [];
+    return [
+      for (final item in list)
+        if (item is Map) Map<String, dynamic>.from(item),
+    ];
+  }
+
+  /// GET /dataset/summary — dataset splits and server storage (read-only).
+  Future<Map<String, dynamic>> datasetSummary() async {
+    try {
+      return await _send('GET', '/dataset/summary');
+    } catch (error) {
+      if (error is BackendException) rethrow;
+      throw BackendException(_describe(error, _baseUrl ?? ''));
+    }
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    _pollTimer?.cancel();
+    super.dispose();
+  }
+}
